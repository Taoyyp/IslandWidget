<Window x:Class="IslandWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛设置 (IslandWidget)"
        Width="470" Height="610"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111622"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="IslandWidget · 融合灵动岛设置" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="双屏边缘停靠 · AI 额度 · 硬件与网速 · 2.4G/蓝牙电量 · 音乐与中转" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Section 1: Dual Monitor & Position -->
                <Border Background="#1B2335" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🖥 双屏与停靠位置" FontWeight="SemiBold" FontSize="13.5" Foreground="#93C5FD" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认所在屏幕" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <ComboBox x:Name="MonitorCombo" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="吸附屏幕边缘" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <ComboBox x:Name="EdgeCombo" Grid.Column="1" Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="顶部边缘（推荐，灵动岛胶囊）" Tag="Top"/>
                                <ComboBoxItem Content="底部边缘（任务栏上方）" Tag="Bottom"/>
                                <ComboBoxItem Content="左侧边缘" Tag="Left"/>
                                <ComboBoxItem Content="右侧边缘" Tag="Right"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="提示：按住灵动岛可直接拉丝拖拽到任意一块屏幕的四条边缘并自动居中/记忆位置。" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Appearance & Behavior -->
                <Border Background="#1B2335" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🎨 主题与低占用行为" FontWeight="SemiBold" FontSize="13.5" Foreground="#F472B6" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="视觉主题" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="深色毛玻璃 (Dark)" Tag="dark"/>
                                <ComboBoxItem Content="浅色毛玻璃 (Light)" Tag="light"/>
                                <ComboBoxItem Content="胭脂撞色 (Wisland Rouge)" Tag="rouge"/>
                                <ComboBoxItem Content="晴空渐变 (Wisland Sky)" Tag="sky"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="毛玻璃不透明度" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="55" Maximum="100" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityText" Grid.Column="2" Text="90%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                        </Grid>
                        <WrapPanel>
                            <CheckBox x:Name="LiquidCheck" Content="启用液态拉丝边缘动效" Foreground="#E2E8F0" Margin="0,0,18,8"/>
                            <CheckBox x:Name="HoverExpandCheck" Content="鼠标悬停自动展开" Foreground="#E2E8F0" Margin="0,0,18,8"/>
                            <CheckBox x:Name="AutoLyricsCheck" Content="播歌时收起态自动显示歌词" Foreground="#E2E8F0" Margin="0,0,18,8"/>
                            <CheckBox x:Name="FullscreenHideCheck" Content="全屏游戏/视频自动隐藏" Foreground="#E2E8F0" Margin="0,0,18,8"/>
                            <CheckBox x:Name="LowPowerCheck" Content="极致低占用模式（静止0帧渲染）" Foreground="#E2E8F0" Margin="0,0,18,8"/>
                            <CheckBox x:Name="PauseLockCheck" Content="锁屏/睡眠暂停后台采集" Foreground="#E2E8F0" Margin="0,0,18,8"/>
                            <CheckBox x:Name="StartupCheck" Content="开机自动启动" Foreground="#E2E8F0" Margin="0,0,18,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Section 3: Quota, Proxy & Weather -->
                <Border Background="#1B2335" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🌐 AI 额度、代理与天气" FontWeight="SemiBold" FontSize="13.5" Foreground="#34D399" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AI 额度刷新间隔" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <ComboBox x:Name="RefreshCombo" Grid.Column="1" Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="1 分钟" Tag="1"/>
                                <ComboBoxItem Content="2 分钟" Tag="2"/>
                                <ComboBoxItem Content="5 分钟（推荐）" Tag="5"/>
                                <ComboBoxItem Content="10 分钟" Tag="10"/>
                                <ComboBoxItem Content="15 分钟" Tag="15"/>
                                <ComboBoxItem Content="30 分钟" Tag="30"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="AutoProxyCheck" Content="自动读取 Windows 系统代理（推荐，兼容 FlClash）" Foreground="#E2E8F0" Margin="0,2,0,8" Checked="AutoProxyCheck_Changed" Unchecked="AutoProxyCheck_Changed"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="手动代理地址" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <TextBox x:Name="ManualProxyBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷代理端口" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <TextBox x:Name="ProxyPortBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="天气城市" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <TextBox x:Name="CityBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="6,0"/>
                            <Button x:Name="GeoBtn" Grid.Column="2" Content="定位城市" Margin="8,0,0,0" Padding="10,4" Click="GeoBtn_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                        </Grid>
                        <TextBlock x:Name="GeoHintText" FontSize="11.5" Foreground="#94A3B8" Margin="120,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="恢复默认居中" Padding="12,6" Margin="0,0,10,0" Click="ResetCenter_Click" Background="#334155" Foreground="#E2E8F0" BorderThickness="0"/>
            <Button Content="取消" Padding="14,6" Margin="0,0,10,0" Click="Cancel_Click" Background="#1E293B" Foreground="#CBD5E1" BorderThickness="0"/>
            <Button Content="保存并应用" Padding="16,6" Click="Save_Click" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
